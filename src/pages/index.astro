---
import BaseLayout from '../layouts/BaseLayout.astro'
import IntroCard from '../components/sections/IntroCard.astro'
import AboutMe from '../components/sections/AboutMe.astro'
import Card from '../components/Card.astro'
import TimeZoneCard from '../components/sections/TimeZoneCard.astro'
import ExperienceCard from '../components/sections/ExperienceCard.astro'
import Projects from '../components/sections/Projects.astro'
import StudyCard from '../components/sections/StudyCard.astro'
import { PROFILE } from "../content/profileData";

const SITE = PROFILE.site
---


<BaseLayout
  title={SITE.SEO.title}
  description={SITE.SEO.description}
>
  <main
    transition:animate="fade"
    class="relative m-auto grid w-full max-w-6xl gap-2 overflow-hidden p-2 sm:gap-2 sm:p-4 md:grid-cols-2 md:gap-3 md:p-6 lg:grid-cols-12 lg:gap-4"
  >
    <Card colSpan="lg:col-span-9 md:col-span-2" rowSpan="md:row-span-1 lg:row-span-4" order={1}>
      <IntroCard/>
    </Card>
    <Card colSpan="lg:col-span-3 md:col-span-1" rowSpan="md:row-span-3 lg:row-span-6" title="About me" order={2}>
      <AboutMe/>
    </Card>

    <Card colSpan="lg:col-span-3 md:col-span-1" rowSpan="md:row-span-3 lg:row-span-4" title="Projects" order={3}>
      <Projects/>
    </Card>

    <Card colSpan="lg:col-span-3 md:col-span-1" rowSpan="md:row-span-1 lg:row-span-2" title="Your time" order={4}>
      <TimeZoneCard/>
    </Card>
    <Card colSpan="lg:col-span-3 md:col-span-1" rowSpan="md:row-span-1 lg:row-span-2" title="My time" order={5}>
      <TimeZoneCard timezone={PROFILE.timezone} />
    </Card>

    <Card colSpan="lg:col-span-4 md:col-span-1" rowSpan="md:row-span-1 lg:row-span-2" order={6}>
      <div class="flex h-full flex-col justify-center">
        <p class="text-xs mb-3 uppercase tracking-widest" style="color: var(--gold); font-family: 'DM Mono', monospace; opacity: 0.6;">
          Mantra
        </p>
        <blockquote
          class="leading-relaxed"
          style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(1.1rem, 2vw, 1.4rem); font-style: italic; color: var(--parchment); opacity: 0.9; border-left: 2px solid var(--gold); padding-left: 1rem;">
          "{PROFILE.words[0]}"
        </blockquote>
      </div>
    </Card>

    <Card colSpan="md:col-span-1 lg:col-span-5" rowSpan="md:row-span-2 lg:row-span-2"
          title="Education & Certificates" order={7}>
      <StudyCard/>
    </Card>

    <Card colSpan="md:col-span-1 lg:col-span-3" rowSpan="md:row-span-2 lg:row-span-2" title="Experiences" order={8}>
      <ExperienceCard/>
    </Card>

    <Card colSpan="md:col-span-1 lg:col-span-6" rowSpan="md:row-span-2 lg:row-span-1" title="Contact" order={9}>
      <div class="flex h-full w-full items-center justify-center text-center">
        <p class="text-sm leading-relaxed" style="font-family: 'Plus Jakarta Sans', sans-serif; color: var(--parchment); opacity: 0.65;">
          Let's build something together. Reach out via
          <a href={PROFILE.links.twitter}
             target="_blank"
             style="color: var(--gold);"
             onmouseover="this.style.textDecoration='underline'"
             onmouseout="this.style.textDecoration='none'">
            Twitter
          </a>
          or drop an email at
          <a href={PROFILE.links.email}
             style="color: var(--gold);"
             onmouseover="this.style.textDecoration='underline'"
             onmouseout="this.style.textDecoration='none'">
            me@nikb.in
          </a>
        </p>
      </div>
    </Card>
  </main>
</BaseLayout>

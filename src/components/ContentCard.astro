---
interface Props {
  title?: string
  body?: string
}

const { title, body } = Astro.props
---

<>
  {title && (
    <h2 class="z-20 m-0 mb-3 text-sm font-medium uppercase tracking-widest"
        style="color: var(--gold); font-family: 'DM Mono', monospace;">
      {title}
    </h2>
  )}
  {body && <p class="m-0 text-base font-light text-muted-foreground">{body}</p>}
  <slot />
</>

---
import ContentCard from './ContentCard.astro'
import { SquareArrowOutUpRight } from 'lucide-react'

interface Props {
  title?: string
  body?: string
  colSpan?: string
  rowSpan?: string
  href?: string
  colorText?: string
}

const { title, body, colSpan, rowSpan, href, colorText } = Astro.props
---

<div
  class={`card-animate group relative col-span-1 h-auto w-full overflow-hidden rounded-xl border p-6 transition-all duration-300 ease-out
    ${colSpan || 'md:col-span-2'}
    ${rowSpan || ''}
    ${href ? 'cursor-pointer' : ''}`}
  style="background-color: var(--card-bg); border-color: var(--border-line);"
>
  <div
    class="pointer-events-none absolute inset-0 rounded-xl opacity-0 transition-opacity duration-300 group-hover:opacity-100"
    style="box-shadow: inset 0 0 60px var(--gold-glow); border: 1px solid var(--gold); border-radius: inherit;"
  ></div>

  {
    href ? (
      <a href={href} class={`block h-full w-full ${colorText || ''}`}>
        <SquareArrowOutUpRight
          className="absolute right-5 top-5 opacity-0 transition-all duration-200 group-hover:opacity-100"
          size={16}
          style={{ color: 'var(--gold)' }}
        />
        <ContentCard title={title} body={body}>
          <slot />
        </ContentCard>
      </a>
    ) : (
      <ContentCard title={title} body={body}>
        <slot />
      </ContentCard>
    )
  }
</div>

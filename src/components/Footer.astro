---
import { PROFILE } from "../content/profileData";
---
<footer class="w-full max-w-6xl mx-auto px-4 py-8"
        style="border-top: 1px solid var(--border-line);">
  <div class="flex flex-col items-center justify-between gap-2 md:flex-row">
    <p class="text-xs" style="font-family: 'Plus Jakarta Sans', sans-serif; color: var(--parchment); opacity: 0.35;">
      Built with precision by <span style="color: var(--gold); opacity: 1;">{PROFILE.firstName}</span> — Astro, React, TypeScript, Tailwind
    </p>
    <p class="text-xs" style="font-family: 'DM Mono', monospace; color: var(--parchment); opacity: 0.25;">
      nikb.in
    </p>
  </div>
</footer>

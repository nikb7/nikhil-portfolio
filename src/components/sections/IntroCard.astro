---
import {Button} from '../ui/button'
import {PROFILE} from "../../content/profileData";
import {Linkedin, Github, Twitter, Instagram} from 'lucide-react'
---

<div class="flex h-full w-full items-start justify-between gap-6">
  <div class="flex flex-col justify-between gap-6 flex-1 min-h-full">
    <div class="flex flex-col gap-4">
      <div>
        <p class="text-sm font-medium uppercase tracking-[0.2em] mb-1"
           style="color: var(--gold); font-family: 'DM Mono', monospace; opacity: 0.8;">
          Hello, world
        </p>
        <h1 class="m-0 leading-none"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: clamp(2.5rem, 5vw, 4rem); font-weight: 600; color: var(--parchment);">
          I'm <span style="font-style: italic; color: var(--gold);">{PROFILE.firstName}</span>.
        </h1>
        <p class="mt-2 text-base font-light" style="color: var(--parchment); opacity: 0.6;">
          {PROFILE.headLine2}
        </p>
      </div>

      <ul class="flex flex-col gap-2 mt-1">
        {PROFILE.shortIntros.map((intro) => (
          <li class="flex items-start gap-3 text-sm leading-relaxed"
              style="font-family: 'Plus Jakarta Sans', sans-serif; color: var(--parchment); opacity: 0.75;">
            <span class="mt-1.5 h-1 w-1 flex-shrink-0 rounded-full" style="background: var(--gold);"></span>
            {intro}
          </li>
        ))}
      </ul>
    </div>

    <div class="flex gap-3">
      <a href={PROFILE.links.github} aria-label="GitHub profile" target="_blank">
        <button class="flex h-9 w-9 items-center justify-center rounded-md border transition-all duration-200 hover:scale-105"
                style="border-color: var(--border-line); background: transparent;"
                onmouseover="this.style.borderColor='var(--gold)'; this.querySelector('svg').style.color='var(--gold)'"
                onmouseout="this.style.borderColor='var(--border-line)'; this.querySelector('svg').style.color='var(--parchment)'">
          <Github size={16} style={{ color: 'var(--parchment)', opacity: 0.7 }} client:load />
        </button>
      </a>
      <a href={PROFILE.links.linkedin} aria-label="LinkedIn profile" target="_blank">
        <button class="flex h-9 w-9 items-center justify-center rounded-md border transition-all duration-200 hover:scale-105"
                style="border-color: var(--border-line); background: transparent;"
                onmouseover="this.style.borderColor='var(--gold)'; this.querySelector('svg').style.color='var(--gold)'"
                onmouseout="this.style.borderColor='var(--border-line)'; this.querySelector('svg').style.color='var(--parchment)'">
          <Linkedin size={16} style={{ color: 'var(--parchment)', opacity: 0.7 }} client:load />
        </button>
      </a>
      <a href={PROFILE.links.twitter} aria-label="X / Twitter profile" target="_blank">
        <button class="flex h-9 w-9 items-center justify-center rounded-md border transition-all duration-200 hover:scale-105"
                style="border-color: var(--border-line); background: transparent;"
                onmouseover="this.style.borderColor='var(--gold)'; this.querySelector('svg').style.color='var(--gold)'"
                onmouseout="this.style.borderColor='var(--border-line)'; this.querySelector('svg').style.color='var(--parchment)'">
          <Twitter size={16} style={{ color: 'var(--parchment)', opacity: 0.7 }} client:load />
        </button>
      </a>
      <a href={PROFILE.links.mayainstagram} aria-label="Maya's Instagram" target="_blank">
        <button class="flex h-9 w-9 items-center justify-center rounded-md border transition-all duration-200 hover:scale-105"
                style="border-color: var(--border-line); background: transparent;"
                onmouseover="this.style.borderColor='var(--gold)'; this.querySelector('svg').style.color='var(--gold)'"
                onmouseout="this.style.borderColor='var(--border-line)'; this.querySelector('svg').style.color='var(--parchment)'">
          <Instagram size={16} style={{ color: 'var(--parchment)', opacity: 0.7 }} client:load />
        </button>
      </a>
    </div>
  </div>

  <img
    src={PROFILE.avatarUrl}
    class="pointer-events-none absolute bottom-[-20px] right-[-80px] z-[-1] max-h-[220px] w-auto select-none opacity-30 md:relative md:bottom-auto md:right-auto md:z-auto md:opacity-100 rounded-xl flex-shrink-0"
    style="filter: sepia(15%) saturate(90%);"
    width="auto"
    height="220"
    alt={`Photo of ${PROFILE.name}`}
  />
</div>

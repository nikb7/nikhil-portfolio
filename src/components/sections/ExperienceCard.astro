---
import { getCollection } from "astro:content";
import { formateLocalDate } from "../../lib/utils";

let experiences = await getCollection('experiences');

experiences.sort((a: any, b: any) => {
  return new Date(b.data.startDate) - new Date(a.data.startDate);
});

experiences = experiences.slice(0, 3);
---

<div class="mt-1 flex flex-col gap-4">
  {
    experiences.map((exp) => (
      <div class="flex flex-col gap-0.5">
        <h4 class="text-base font-semibold leading-tight"
            style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.05rem; color: var(--parchment);">
          {exp.data.title}
        </h4>
        <a class="text-xs font-medium transition-colors duration-150"
           href={'/experiences/' + exp?.id ?? ''}
           style="color: var(--gold); font-family: 'Plus Jakarta Sans', sans-serif;"
           onmouseover="this.style.textDecoration='underline'"
           onmouseout="this.style.textDecoration='none'">
          {exp.data.company}
        </a>
        <p class="text-xs" style="color: var(--parchment); opacity: 0.45; font-family: 'DM Mono', monospace;">
          {formateLocalDate(exp.data.startDate)}{exp.data?.endDate ? ' — ' + formateLocalDate(exp.data.endDate) : ' — present'}
        </p>
      </div>
    ))
  }
  <a href="/experiences"
     class="mt-1 text-xs font-medium tracking-wide transition-colors duration-150"
     style="color: var(--gold); font-family: 'Plus Jakarta Sans', sans-serif; opacity: 0.8; text-decoration: underline; text-underline-offset: 3px;"
     onmouseover="this.style.opacity='1'"
     onmouseout="this.style.opacity='0.8'">
    View all →
  </a>
</div>

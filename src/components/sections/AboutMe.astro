---
import { getAndGroupUniqueTags } from "../../lib/content-utils";
import { PROFILE } from "../../content/profileData";

const tagsMap = await getAndGroupUniqueTags();
const skills = PROFILE.skills;
---

<div class="flex flex-col gap-3 animate-appear">
  <p class="text-base leading-relaxed" style="font-family: 'Plus Jakarta Sans', sans-serif; font-size: 1.1rem; color: var(--parchment); opacity: 0.85;">
    {PROFILE.headLine}
  </p>

  <div class="my-1" style="height: 1px; background: linear-gradient(to right, var(--gold), transparent); opacity: 0.3;"></div>

  <p class="text-xs font-medium uppercase tracking-widest mb-1"
     style="color: var(--gold); font-family: 'DM Mono', monospace; opacity: 0.7;">
    Stack
  </p>

  <div class="flex flex-wrap gap-1.5">
    {
      skills.map((skill) => {
        if (tagsMap.has(skill)) {
          return (
            <a href={`/tags/${skill}`}
               class="rounded px-2 py-0.5 text-xs transition-all duration-150 hover:scale-105"
               style="font-family: 'DM Mono', monospace; border: 1px solid var(--border-line); color: var(--parchment); opacity: 0.7; background: transparent;"
               onmouseover="this.style.borderColor='var(--gold)'; this.style.color='var(--gold)'; this.style.opacity='1'"
               onmouseout="this.style.borderColor='var(--border-line)'; this.style.color='var(--parchment)'; this.style.opacity='0.7'">
              {skill}
            </a>
          )
        } else {
          return (
            <span class="rounded px-2 py-0.5 text-xs"
                  style="font-family: 'DM Mono', monospace; border: 1px solid var(--border-line); color: var(--parchment); opacity: 0.6;">
              {skill}
            </span>
          )
        }
      })
    }
  </div>

  <div class="mt-2 flex gap-3 text-xs" style="font-family: 'Plus Jakarta Sans', sans-serif;">
    <a href="/projects"
       class="transition-colors duration-150"
       style="color: var(--gold); text-decoration: underline; text-underline-offset: 3px;">
      Projects →
    </a>
    <a href="/experiences"
       class="transition-colors duration-150"
       style="color: var(--gold); text-decoration: underline; text-underline-offset: 3px;">
      Experience →
    </a>
  </div>
</div>
